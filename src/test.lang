ε = /\s+/

truth = /true|false/
name = /[a-zA-Z]+/
number = /[0-9]+/
string = /"[^"]*"/

start -> statements

statements -> statement statements
statements -> ε

statement -> assignment ;
statement -> if_statement
statement -> print_statement ;

exp -> name
exp -> truth

val -> name
val -> number
val-> string

assignment -> name = exp

if_statement -> `if` exp { statements }

print_statement -> `print` ( val )
