ε = /\s/
num = /[0-9]+/
identifier = /[a-zA-Z_]+/
sum_operator = /\+|-/
mul_operator = /\*|//

start -> exp

exp -> sums

sums -> products sum_rest

sum_rest -> sum_operator sums
sum_rest -> ε

products -> atom product_rest
product_rest -> mul_operator products
product_rest -> ε

products -> ( exp )

atom -> num
atom -> identifier
