ε = /[\t ]+/
newline = /\n/
name = /[a-zA-Z_][a-zA-Z_0-9]*|ε/
regex = /\/.*\// 
number = /[0-9]+/
arrow = /->/
action_arrow = />>/

literal = /`.+`|[^=]/

* = /./

start -> lines

id -> name
id -> literal

lines -> line newline lines
lines -> line

line -> ε
line -> id = regex
line -> id arrow cfg_body
line -> id arrow cfg_body action_routine

cfg_body -> id cfg_body
cfg_body -> id


action_routine -> action_arrow . id = action_body

action_body -> action_id
action_body -> [ action_id_list ]
action_body -> ( id ) [ action_id_list ]

action_id -> id . id 
action_id -> id ~ number . id

action_id_list -> action_id action_id_list
action_id_list -> action_id
