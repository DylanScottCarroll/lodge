ε = /[\t ]/
newline = /\n/
regex = /\/.*\// 
id = /[a-zZ-Z_][a-zA-Z_0-9]+|ε/
number = /[0-9]+/
arrow = /->/

lines -> line newline lines
lines -> ε

line -> id line_body 
line -> newline 

line_body -> token_body
line_body -> cfg_body

token_body -> = regex
cfg_body -> arrow cfg_item cfg_r

cfg_item -> id
cfg_item -> action_routine 

cfg_r -> cfg_item cfg_r
cfg_r -> ε


action_routine -> { routine_id = routine_rhs }
routine_rhs -> routine_piece routine_rhs_r

routine_rhs_r -> routine_piece + routine_rhs_r
routine_rhs_r -> ε

routine_piece -> routine_id
routine_piece -> routine_node

routine_node ->  ( routine_id , routine_node_r )
routine_node_r -> routine_id routine_node_r
routine_node_r -> ε

routine_id -> id opt_num . id 
opt_num -> ~ number
opt_num -> ε
